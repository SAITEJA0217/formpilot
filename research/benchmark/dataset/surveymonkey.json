    { "label": "Email Address", "type": "text", "concept": "person.email", "expected": "saiteja@example.com", "outcome": "fill" },
    { "label": "Years of Experience", "type": "radio_group", "concept": "experience.years_of_experience", "expected": "0-2 years", "outcome": "fill" },
    { "label": "Technical Skills", "type": "checkbox_group", "concept": "skills.technical", "expected": ["TypeScript", "React", "Python"], "outcome": "fill" },
    { "label": "Highest Qualification", "type": "select_one", "concept": "education.degree", "expected": "Bachelor's Degree", "outcome": "fill" },
    { "label": "Rate your confidence: Frontend", "type": "radio_group", "concept": null, "expected": null, "outcome": "review" },
    { "label": "Rate your confidence: Backend", "type": "radio_group", "concept": null, "expected": null, "outcome": "review" },
    { "label": "Anything else we should know?", "type": "textarea", "concept": "freeform.other", "expected": null, "outcome": "model" }
  ]
