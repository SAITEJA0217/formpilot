# ── Firebase (client) ─────────────────────────────────────────────────────────
# Public by design: these values ship to the browser. Access is controlled by
# Firebase security rules (see firebase/firestore.rules), not by hiding them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only) ──────────────────────────────────────────────
# Never prefix these with NEXT_PUBLIC_. They verify ID tokens and write Firestore.
FIREBASE_CLIENT_EMAIL=
# Paste the PEM with literal \n escapes, or as a real multi-line value.
FIREBASE_PRIVATE_KEY=

# ── AI provider (server only) ─────────────────────────────────────────────────
# Which provider the API routes use. `gemini` (default) or `openai-compatible`.
# `openai-compatible` is implemented but has not been verified against a live
# endpoint — see research/limitations.md.
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini. Also used by /api/ai/parse-resume, which is a
# multimodal call and remains Gemini-specific.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-2.5-flash (the v1 model).
GEMINI_MODEL=

# Required when AI_PROVIDER=openai-compatible.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API, in addition to browser
# extensions (chrome-extension:// and moz-extension:// are always allowed) and,
# outside production, localhost. An unlisted origin receives no CORS headers.
ALLOWED_ORIGINS=
