{
  "dependencies": {
    "firebase": "^12.15.0"
  },
  "name": "formpilot",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "FormPilot \u2014 universal semantic web form understanding and human-in-the-loop autofill",
  "scripts": {
    "test": "vitest run",
    "test:safety": "vitest run tests/safety",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:extension": "npm --prefix extension run typecheck",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:extension && npm run typecheck:frontend",
    "lint": "npm --prefix frontend run lint",
    "build:extension": "npm --prefix extension run build",
    "build:frontend": "npm --prefix frontend run build",
    "bench": "vite-node research/benchmark/run.ts",
    "study:matching": "vite-node research/matching/run.ts",
    "study:performance": "vite-node research/performance/run.ts",
    "study:routing": "vite-node research/routing/run.ts",
    "test:e2e": "playwright test",
    "build:apps": "node tests/e2e/apps/build.mjs"
  },
  "devDependencies": {
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "typescript": "^5.7.2",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.43",
    "zone.js": "^0.14.10"
  }
}
