# Dependencies
node_modules/

# Build output
dist/
.next/
out/

# Environment files — never commit real values; .env.example documents the shape
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*

# TypeScript
*.tsbuildinfo

# Playwright artifacts: the browser profile, traces and screenshots each run rewrites
tests/e2e/.artifacts/
playwright-report/

# Built by tests/e2e/apps/build.mjs; regenerate with npm run build:apps
tests/e2e/apps/dist/

# Git bundles written when a push is refused. They contain the history itself, so
# committing one into that history would be circular.
.recovery/
